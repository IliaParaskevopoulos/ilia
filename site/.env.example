# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/nestor"

# Random secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="change-me"

# Password for the operator /admin area (separate from any company's
# access code). Generate something you'll actually remember or store in
# a password manager.
ADMIN_PASSWORD="change-me"
