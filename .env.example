# Copy this file to .env for local testing. Never commit the real .env file.

# Required for research + drafting (Anthropic Console -> API Keys)
ANTHROPIC_API_KEY=

# Required only when sending (Resend dashboard -> API Keys). Not needed to generate drafts.
RESEND_API_KEY=

# The address newsletters are sent from. Must be on a domain verified in Resend.
FROM_EMAIL=weekly-briefing@yourdomain.com
